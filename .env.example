# Copy to .env.local (git-ignored) and fill in, then restart `expo start` or
# re-run `npx expo export --platform web`. Expo inlines this at bundle time.
#
# Spotify Client ID from https://developer.spotify.com/dashboard — a public
# value (the app uses PKCE, so there is no client secret). Register the exact
# redirect URI(s) http://127.0.0.1:8081/ (dev) and http://127.0.0.1:8080/ (Pi
# kiosk); Spotify does not accept "localhost".
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
