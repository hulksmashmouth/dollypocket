# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# generated TTS cache + imported knowledge base (re-fetchable from Wikipedia
# via scripts/import-knowledge.mjs) — never commit these
/server/data/

# Piper TTS venv + downloaded voice models — large, platform-specific, re-fetchable
/server/piper-venv/
/server/voices/
