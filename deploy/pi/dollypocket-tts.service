[Unit]
Description=Dolly Pocket text-to-speech server (Piper + Southern drawl)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/dollypocket
Environment=PIPER_VOICE=en_US-amy-medium
Environment=PIPER_DATA_DIR=/home/pi/dollypocket/server/voices
Environment=PORT=11436
ExecStart=/home/pi/dollypocket/server/piper-venv/bin/python3 server/piper-tts-server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
